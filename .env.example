# =============================================================================
# SynthMind — Environment Variables Configuration
# =============================================================================
# Copy this file to .env and insert your API keys:
# cp .env.example .env
# =============================================================================

# ---- Required: Google AI Studio API Key ----
# Get your free key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# ---- Optional: Tavily Search API Key ----
# Get a key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ---- Model Configuration (Defaults shown) ----
LLM_CHAT_MODEL=gemma-4-31b-it
LLM_EMBEDDING_MODEL=gemini-embedding-2-preview
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=60

# ---- Vector Store & Retrieval Settings ----
DOCUMENTS_DIR=./documents
FAISS_INDEX_DIR=./faiss_index
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SEARCH_K=5

# ---- Application Settings ----
APP_NAME=SynthMind: GenAI Multi-Agent Assistant
LOG_LEVEL=INFO
DEBUG=false
